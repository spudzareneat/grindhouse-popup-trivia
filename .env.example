# Long-lived subscription token: run `claude setup-token` on any machine logged in to your Claude account.
CLAUDE_CODE_OAUTH_TOKEN=
# Model for research (sonnet = good balance of quality vs. subscription usage; opus = best, uses more).
CLAUDE_MODEL=sonnet
# SSH URL of this repo; the deploy key in ./secrets/deploy_key must have WRITE access.
GIT_REMOTE=git@github.com:spudzareneat/grindhouse-popup-trivia.git
GIT_AUTHOR_NAME=grindhouse-popup-trivia bot
GIT_AUTHOR_EMAIL=bot@users.noreply.github.com
# Optional extra source (TMDB v3 API key).
TMDB_API_KEY=
# Optional: English subtitles, used to pin facts to the scene they're about. Free key: opensubtitles.com ->
# profile -> API consumers. Username/password (same free account) raise the daily download quota.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# Optional Discord bot (see README): bot token from the Discord developer portal.
DISCORD_BOT_TOKEN=
# Channel id where the run summary and pickers are posted.
DISCORD_CHANNEL_ID=
# Your Discord user id; only you can click the picker buttons.
DISCORD_OWNER_ID=
# Seconds to wait between movies, and per-movie Claude timeout in minutes.
MOVIE_DELAY_SEC=60
CLAUDE_TIMEOUT_MIN=30
TZ=America/Los_Angeles
# Host path of the deploy key (Portainer: absolute path; plain compose defaults to ./secrets/deploy_key).
# DEPLOY_KEY_PATH=/opt/grindhouse-popup-trivia/deploy_key

# Personal Reddit feed URL (reddit.com/prefs/feeds). Required in practice: the public feed gets 403-blocked.
REDDIT_FEED_URL=
